{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": { "@/*": ["./frontend/*"] }
  },
  "include": ["frontend", "scripts/*.ts", "scripts/*.tsx", "vite.config.ts", "edge", "tests", "worker-configuration.d.ts"]
}
